# ── Frontend (Vite, baked into the client bundle — NEVER put secrets here) ──
# Base path the SPA uses for API calls. In production this is same-origin (""),
# because Cloudflare Functions serve /api/* on command.mbfdhub.com.
VITE_API_BASE=""
# Org label shown in the header.
VITE_ORG_NAME="Miami Beach Fire Department"
# Optional Sentry DSN (browser). Leave blank to disable.
VITE_SENTRY_DSN=""

# ── Local dev only ──
# When running plain `vite dev` (no wrangler), proxy /api straight to a hub origin.
VITE_DEV_HUB_PROXY="https://www.mbfdhub.com"

# ── Cloudflare Functions secrets (set with `wrangler pages secret put NAME`) ──
# These are server-side only and never reach the browser. Do NOT commit real values.
# HUB_BASE            — hub origin the edge gateway fetches from (e.g. https://www.mbfdhub.com)
# HUB_DISPLAY_TOKEN   — optional shared secret sent as X-Display-Token to the hub origin
# CF_ACCESS_AUD       — Cloudflare Access application AUD tag (for optional JWT verification)
# CF_ACCESS_TEAM      — Access team domain (e.g. darl.cloudflareaccess.com)
