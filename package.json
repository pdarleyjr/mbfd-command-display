{
  "name": "mbfd-command-display",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only MBFD Command Display Dashboard (command.mbfdhub.com)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test:e2e": "playwright test",
